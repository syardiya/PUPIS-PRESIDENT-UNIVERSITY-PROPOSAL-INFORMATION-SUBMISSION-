# ==============================================================================
# PUPIS — President University Proposal Information Submission
# Environment Variables Template (Copy to .env.local and fill in real values)
# NEVER commit real API keys or secrets to version control.
# ==============================================================================

# Public Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Server-Only Supabase Key (Required only for trusted server actions / admin jobs)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Institutional Domain Whitelist & Private Storage Bucket Names
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=student.president.ac.id,president.ac.id
NEXT_PUBLIC_PROPOSAL_DOCS_BUCKET=proposal-documents
NEXT_PUBLIC_SIGNATURES_BUCKET=user-signatures
